# Copy to .env and fill in what you use. .env is git-ignored.

# --- Databricks (the original setup: SQL warehouse + hosted Llama) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Optional switches. Leave blank to auto-detect ---
# DATA_BACKEND=local        # local = DuckDB over data/raw (no Databricks needed) | databricks
# LLM_BACKEND=mock          # mock = scripted, free | databricks | anthropic

# --- Only if LLM_BACKEND=anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Website protection (defaults shown) ---
# ASK_PER_MINUTE=5
# ASK_PER_DAY=200
# MAX_QUESTION_CHARS=300
